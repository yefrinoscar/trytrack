{
  "name": "spends",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "build": "vp build",
    "preview": "vp preview",
    "preview:worker": "vp exec wrangler dev --config .output/server/wrangler.json",
    "deploy:worker": "vp exec wrangler deploy --config .output/server/wrangler.json",
    "test": "vp test",
    "lint": "vp lint",
    "format": "vp fmt --check .",
    "check": "vp check",
    "db:generate": "vp exec drizzle-kit generate && cp drizzle/*.sql migrations/",
    "db:migrate:local": "vp exec wrangler d1 migrations apply trytrack --local",
    "db:migrate:remote": "vp exec wrangler d1 migrations apply trytrack --remote",
    "db:migrate:convex": "node scripts/migrate-convex-export.mjs",
    "import:gmail-may": "node scripts/import-gmail-may.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.5.3",
    "@faker-js/faker": "^10.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-devtools": "0.10.0",
    "@tanstack/react-query": "5.95.1",
    "@tanstack/react-query-devtools": "5.95.1",
    "@tanstack/react-router": "^1.167.0",
    "@tanstack/react-router-devtools": "^1.166.7",
    "@tanstack/react-router-ssr-query": "^1.166.7",
    "@tanstack/react-start": "^1.167.5",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/router-plugin": "^1.166.9",
    "better-auth": "1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260415-beta",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^28.1.0",
    "lru-cache": "^11.3.5",
    "readdirp": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.13",
    "vite-plus": "0.1.13",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.13",
    "wrangler": "^4.93.0"
  },
