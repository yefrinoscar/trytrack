# Local dev (Node). Copy to .env.local and fill in.
# Better Auth signing secret. Required. 32+ random chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL the app is served from (must match Cloudflare route / SITE_URL).
SITE_URL=http://localhost:3000
# Optional comma-separated extra allowed origins.
# TRUSTED_ORIGINS=

# Local SQLite file used by `vp dev` / scripts. Not used on Cloudflare (D1 binding `DB`).
# LOCAL_DB_PATH=local.db

# Optional: forgot-password emails (Resend). Set on the Worker as secrets.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Gmail expense import (optional, owner-only).
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# OWNER_EMAIL=
# GMAIL_PUBSUB_TOPIC=
# GMAIL_PUBSUB_WEBHOOK_SECRET=
# GMAIL_SYNC_SECRET=
# GMAIL_POLL_NEWER_THAN_DAYS=3
# GMAIL_POLL_MAX_MESSAGES=50
